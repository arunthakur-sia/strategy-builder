# ── Next.js App Config ────────────────────────────────────────────────────────
# Session signing secret (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-32-char-string

NODE_ENV=development

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to "true" to use local file-based storage instead of Supabase
# LOCAL_DB=true

# ── Vercel Blob (document uploads) ───────────────────────────────────────────
# Required for document upload to work. Create a Blob store under Vercel
# dashboard -> Storage -> Blob, connect it to this project, then run
# `vercel env pull .env.local` to fetch this value for local development.
BLOB_READ_WRITE_TOKEN=your-blob-read-write-token

# ── SiaGPT (AI Backend - Claude) ──────────────────────────────────────────────
SIAGPT_BASE_URL=https://backend.siagpt.ai
SIAGPT_PROJECT_ID=your-project-uuid
SIAGPT_MEDIA_FOLDER_ID=your-media-folder-uuid
SIAGPT_OWNER_ID=your-owner-uuid

# Optional: appended to every SiaGPT message payload when set (SiaGPT-specific bundling)
# SIAGPT_BUNDLE_ID=

# Optional: generic fallback agent used only when no per-task assistant ID is provided.
# In practice this is never hit if all SIAGPT_ASSISTANT_* vars below are filled in.
# SIAGPT_ASSISTANT_ID=

# Per-pillar SiaGPT agent IDs
SIAGPT_ASSISTANT_P1=
SIAGPT_ASSISTANT_P2=
SIAGPT_ASSISTANT_P3=
SIAGPT_ASSISTANT_P4=
SIAGPT_ASSISTANT_P5=
SIAGPT_ASSISTANT_P6=
SIAGPT_ASSISTANT_P7=
SIAGPT_ASSISTANT_P8=

# Non-pillar agents
SIAGPT_ASSISTANT_SWOT=
SIAGPT_ASSISTANT_STRATEGY=
SIAGPT_ASSISTANT_CHAT=
SIAGPT_ASSISTANT_D1=
SIAGPT_ASSISTANT_D2=
SIAGPT_ASSISTANT_D3=
SIAGPT_ASSISTANT_D4=
SIAGPT_ASSISTANT_D5=
SIAGPT_ASSISTANT_D6=

# ── OAuth2 (Zitadel — used to get SiaGPT access tokens) ──────────────────────
OAUTH2_TOKEN_URL=https://your-zitadel-instance.com/oauth/v2/token
OAUTH2_CLIENT_ID=your-client-id
OAUTH2_CLIENT_SECRET=your-client-secret
ZITADEL_PROJECT_ID=your-zitadel-project-id

# Dev-only shortcut: static bearer token (skips OAuth2 entirely)
# SIAGPT_BEARER_TOKEN=your-static-token

# ── CORS (optional — not needed for same-origin Next.js deployment) ───────────
# CORS_ORIGINS=https://your-frontend.vercel.app

# ── App Name ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=SIA Strategy Assessment Agent

# ── Wave 2 (Formulation) — one SiaGPT assistant per node in the Wave 2 flow diagram ──────────────
# 1. Strategic Direction
SIAGPT_ASSISTANT_W2_STRATEGIC_DIRECTION=

# 2. V/M/V (vision, mission, values)
SIAGPT_ASSISTANT_W2_VMV=

# 3a. Strategic Options Design Agent (optional step)
SIAGPT_ASSISTANT_W2_OPTIONS_DESIGN=

# 3b. Strategic Options Evaluation & Selection Agent (optional step)
SIAGPT_ASSISTANT_W2_OPTIONS_EVAL=

# 4. SWOT Part B
SIAGPT_ASSISTANT_W2_SWOT_B=

# 5. Shift Agenda
SIAGPT_ASSISTANT_W2_SHIFT_AGENDA=

# ── Wave 3 (Translation) — one SiaGPT assistant per agent node in the Wave 3 flow diagram ────────
# (Step 5, the Strategy Visualisation / BI Dashboard, has no assistant: it is generated by the report LLM
#  below from the conversations of the agents here plus V/M/V.)
# 1. Strategy Map
SIAGPT_ASSISTANT_W3_STRATEGY_MAP=

# 2. KPIs / Performance
SIAGPT_ASSISTANT_W3_KPIS=

# 3. Initiatives definition
SIAGPT_ASSISTANT_W3_INITIATIVES=

# 4. Initiatives prioritisation
SIAGPT_ASSISTANT_W3_PRIORITISATION=

# ── Report export LLM (LiteLLM gateway, OpenAI-compatible) ───────────────────────────────────────
# Turns an approved agent conversation into a corporate-grade markdown report (PDF / DOCX / MD export).
REPORT_LLM_BASE_URL=https://litellm.heka.ai/v1
REPORT_LLM_API_KEY=
REPORT_LLM_MODEL=bedrock-opus-4.6
# Max output tokens (Opus 4.6 supports up to 128000)
REPORT_LLM_MAX_TOKENS=128000
